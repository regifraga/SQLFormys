# Template de variáveis de ambiente — SQLFormys
# Copie este arquivo para ".env" e preencha com seus valores reais.
# O arquivo ".env" NUNCA deve ser versionado.

# =============================================================
# Banco de Dados (Azure SQL Edge / SQL Server - Inativo)
# =============================================================
# SA_PASSWORD=SuaSenhaAqui
# DB_DRIVER=sqlserver
# DB_DSN=sqlserver://sa:SuaSenhaAqui@db:1433?database=master&encrypt=disable

# =============================================================
# Banco de Dados (PostgreSQL - Ativo)
# =============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuaSenhaAqui
POSTGRES_DB=sqlformys
DB_DRIVER=postgres
DB_DSN=postgres://postgres:SuaSenhaAqui@db:5432/sqlformys?sslmode=disable

# =============================================================
# API Backend (Go)
# =============================================================
PORT=8080
QUERIES_BASE_PATH=queries
# Caminho opcional do executável PowerShell (módulos .ps1) quando não estiver no PATH
# PWSH_PATH=/usr/local/bin/pwsh
# Opcional: Google Programmable Search (módulo exemplo "Busca Google.sh")
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
PRODUCT_NAME=

# =============================================================
# Log da API (arquivo com rotação)
# =============================================================
LOG_ENABLED=true
LOG_DIR=logs
LOG_FILE=api.log
# size = rotação por tamanho | daily (ou date) = rotação por dia
LOG_ROTATION=size
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=10
# Em produção, use false se quiser só arquivo
LOG_TO_STDOUT=true
# Corpo JSON em POST/PUT/PATCH (0 = não registrar corpo)
LOG_REQUEST_BODY_MAX_BYTES=4096

# =============================================================
# Ambiente
# =============================================================
APP_ENV=production
# Docker Compose / produção (Nginx proxy): /api | dev direto na API: http://localhost:8080/api
API_BASE_URL=/api

# =============================================================
# Autenticação de rede (estilo IIS / Negotiate-Kerberos)
# =============================================================
# false = app aberta (comportamento padrão)
# true = exige identidade de rede em todas as rotas /api/*
AUTH_ENABLED=false

# Desenvolvimento local (Linux sem AD): simula DOMINIO\usuario quando APP_ENV=development
# AUTH_DEV_USER=EMPRESA\regivaldo

# Produção com AUTH_ENABLED=true (obrigatório fora de development):
# AUTH_KRB_KEYTAB=/caminho/para/http.keytab
# AUTH_KRB_SPN=HTTP/sqlformys.empresa.local

# Com AUTH_ENABLED=true, use o Nginx como gateway e URL relativa no front:
# API_BASE_URL=/api

# =============================================================
# Acesso sem Active Directory (HTTP Basic no Nginx do front)
# =============================================================
# Recomendado em Linux/Docker quando infra não fornece Kerberos.
# Mantenha AUTH_ENABLED=false — o login é só no Nginx (popup do navegador).
# Caminho no servidor (host) do arquivo htpasswd — fora do repo/container
# NGINX_BASIC_AUTH_HTPASSWD_HOST_PATH=/var/lib/sqlformys/htpasswd
# Caminho dentro do container (deve bater com o destino do volume acima)
# NGINX_BASIC_AUTH_HTPASSWD_FILE=/etc/nginx/secrets/htpasswd
# Gere o arquivo no host antes de ligar (veja front/secrets/README.md).
NGINX_BASIC_AUTH_ENABLED=false
NGINX_BASIC_AUTH_REALM=SQLFormys

# =============================================================
# Administradores e gestão de senhas (API + htpasswd)
# =============================================================
# Usuários listados aqui viram admins na primeira inicialização (arquivo persistente).
# ADMINISTRATORS=admin.usuario,outro.admin
# No Docker, a API usa sempre /app/secrets/htpasswd (mesmo arquivo montado que o Nginx — ver compose).
# Host: NGINX_BASIC_AUTH_HTPASSWD_HOST_PATH=./htpasswd
# Host: ADMINISTRATORS_HOST_PATH=./administrators  (arquivo de texto, uma linha por admin)
# Não defina HTPASSWD_PATH no .env do Compose — isso é só para go run local (ex.: ../htpasswd).

# Preferências por usuário (JSON na API; volume no Docker)
# USER_SETTINGS_HOST_PATH=./user-settings

